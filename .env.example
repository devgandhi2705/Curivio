# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

TAVILY_API_KEY=your_tavily_api_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Scheduler ─────────────────────────────────────────────────────────────────
# UTC hour (0-23) for daily package auto-generation
SCHEDULER_JOB_HOUR=8
SCHEDULER_DEFAULT_INTERESTS=AI agents and large language models

# ── Cache ─────────────────────────────────────────────────────────────────────
FEED_CACHE_TTL_HOURS=24

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret key for JWT signing — change this in production!
AUTH_SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── Email (for forgot-password) ───────────────────────────────────────────────
# Gmail: enable 2FA then generate an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_gmail_address@gmail.com
# Base URL of the frontend (included in reset email links)
APP_URL=http://localhost:5173

# ── Rate limits ───────────────────────────────────────────────────────────────
GENERATE_FEED_RATE_LIMIT=3/minute
SEARCH_RATE_LIMIT=5/minute
FEEDBACK_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=20/minute
PROJECTS_RATE_LIMIT=30/minute
INSIGHT_GEN_RATE=5/minute

# ── Deployment (Docker / HF Spaces) ──────────────────────────────────────────
# Absolute path for the SQLite database.
# Docker/HF Spaces: /data/memory.db (HF Spaces persists /data between restarts)
# Local dev: leave unset (defaults to ./data/memory.db relative to project root)
DB_PATH=

# CORS in Docker: frontend + backend are same-origin, so CORS_ORIGINS can be *
# or the specific HF Spaces URL: https://your-username-curivio.hf.space
# CORS_ORIGINS=*

# Scheduler timezone (IANA format, default UTC)
# SCHEDULER_TIMEZONE=UTC
